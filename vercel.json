{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "500mb",
        "includeFiles": ["backend/**", "ml/models/revision_scheduler_model.pkl", "ml/artifacts/feature_importances.json"]
      }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "/api/index.py" }]
}
