# Handle line endings
* text=auto

# Force text files
*.md text
*.txt text
*.py text
*.jsx text
*.js text
*.ts text
*.tsx text
*.json text
*.css text
*.html text
*.yml text
*.yaml text
*.sh text eol=lf
*.ps1 text eol=crlf

# Binary files
*.pkl binary
*.db binary
*.sqlite binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.gif binary
*.svg text
